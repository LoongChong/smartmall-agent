# ============ SmartMall Agent 配置示例 ============
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，切勿提交真实密钥。

SMA_ENV=dev
SMA_LOG_LEVEL=INFO
SMA_LOG_JSON=true

# ---------- LLM ----------
# mock：无需密钥，确定性输出，用于测试与演示
# deepseek：真实模型，需要 SMA_LLM_API_KEY
SMA_LLM_PROVIDER=mock
SMA_LLM_API_KEY=
SMA_LLM_BASE_URL=https://api.deepseek.com/v1
SMA_LLM_MODEL=deepseek-chat
SMA_LLM_TIMEOUT_SECONDS=45
SMA_LLM_MAX_RETRIES=2
SMA_LLM_TEMPERATURE=0.1
SMA_LLM_MAX_TOKENS=2048

# ---------- Embedding ----------
# hash：本地确定性哈希向量，无需外部服务（默认）。
#       注意：这是词面相似而非语义向量，生产环境请换成真实 embedding。
# deepseek_compatible：OpenAI 兼容的 /embeddings 接口，需要 SMA_EMBEDDING_API_KEY
SMA_EMBEDDING_PROVIDER=hash
SMA_EMBEDDING_API_KEY=
SMA_EMBEDDING_BASE_URL=https://api.deepseek.com/v1
SMA_EMBEDDING_MODEL=text-embedding-ada-002
# 换成真实 embedding 时必须改成对应模型的维度（如 1536），并执行全量重建
SMA_EMBEDDING_DIM=256
SMA_EMBEDDING_BATCH_SIZE=32

# ---------- 知识库 ----------
SMA_KNOWLEDGE_DIR=data/knowledge
SMA_CHROMA_DIR=data/chroma
SMA_COLLECTION_NAME=smartmall_kb
SMA_CHUNK_SIZE=320
SMA_CHUNK_OVERLAP=64

# ---------- 检索 ----------
# vector | bm25 | hybrid | hybrid_rerank
SMA_RETRIEVAL_MODE=hybrid
SMA_TOP_K=4
SMA_CANDIDATE_K=10
SMA_RRF_K=60
SMA_CONTEXT_MAX_CHARS=4000

# ---------- Agent ----------
SMA_MAX_TOOL_CALLS=3
SMA_TOOL_TIMEOUT_SECONDS=10
SMA_SESSION_MAX_TURNS=10

# ---------- 持久化 ----------
SMA_DB_PATH=data/sma.db

# ---------- 安全 ----------
# 留空则 /api/v1/knowledge/reindex 与 /api/v1/tools 直接返回 401（默认不开放）
SMA_API_ADMIN_TOKEN=
SMA_REINDEX_REQUIRES_ADMIN=true
